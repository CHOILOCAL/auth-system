# =============================================================================
# Environment Template
# =============================================================================
# Copy this file to `.env.local` (gitignored) and fill in real values.
# All variables prefixed with VITE_ are bundled into the client at build time;
# never put true secrets (service-role keys, OAuth client secrets) in here.
# =============================================================================

# ---- Supabase (public) ------------------------------------------------------
# Project URL e.g. https://xxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Anon (publishable) key. NOT the service-role key.
VITE_SUPABASE_ANON_KEY=

# ---- Kakao OAuth ------------------------------------------------------------
# REST API key from Kakao Developers > My Application > App Keys.
# This is a public client identifier (safe to expose), but the OAuth flow itself
# is delegated to Supabase. Configure scopes (minimal: profile_nickname only)
# in the Kakao Developer Console under "동의항목" (Consent Items).
VITE_KAKAO_REST_API_KEY=

# ---- App branding ----------------------------------------------------------
VITE_APP_NAME=SecureAuth
# Public URL the app is served from. Used to build OAuth redirect URLs.
# In dev, leave blank and the client falls back to `window.location.origin`.
VITE_APP_URL=

# ---- Server (production static server only) --------------------------------
# Optional. Defaults to 3000.
PORT=3000
